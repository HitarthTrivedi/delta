# Copy to backend/.env and fill in. Never commit .env: real keys live only in
# your local .env and in the hosting provider's encrypted settings.

# --- Database ---
# Local development uses SQLite. Production: the Supabase "Session pooler"
# connection string (IPv4), with ?sslmode=require appended, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Schema changes go through Alembic (see docs/OPERATIONS.md).
DATABASE_URL=sqlite:///./delta.db
# Connections per process. Keep (size + overflow) x processes under Supabase's limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Auth (Supabase) ---
# Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret
# Needed so "Delete account" also removes the Supabase login (not just the data).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Trust the unverified X-User-Id header instead of a Supabase JWT.
# true ONLY on your own machine, together with REACT_APP_DEV_AUTH=true in the
# frontend (local dev login). MUST be false everywhere else.
ALLOW_HEADER_AUTH=false
# Local testing only: turns off weekly pacing guards and lets the app return
# canned AI replies when no Gemini key is set. MUST be false everywhere else.
DEV_MODE=false

# --- CORS ---
# Comma-separated frontend origins. Defaults to localhost:3000 when empty;
# production must list its real domain(s).
CORS_ORIGINS=

# --- AI ---
# Up to 5 Gemini keys are rotated on rate limits.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Default model: reports, tests, roadmaps (where quality shows).
GEMINI_MODEL=gemini-2.5-flash
# Tried once when GEMINI_MODEL is overloaded or rate-limited. Empty = no retry.
GEMINI_BACKUP_MODEL=gemini-2.5-flash-lite
# Cheap, fast model for chatty calls such as interview turns.
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
# Optional: Groq for fast chat models (falls back to Gemini without it).
GROQ_API_KEY=
GROQ_QUALITY_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- AI routing, spend and caps (defaults in app/config.py; see OPERATIONS.md 7A) ---
# Optional JSON overrides, e.g. {"chat_reply": "lite"} / {"gemini-2.5-flash": [0.30, 2.50]}.
AI_ROUTES_JSON=
AI_PRICES_JSON=
# Monthly AI budget in USD. Empty = no alerts and no degrading.
AI_MONTHLY_BUDGET_USD=
AI_BUDGET_THRESHOLDS=50,80,100
# Optional JSON override of monthly caps per plan, e.g. {"solo": {"chat": 400}}.
AI_CAPS_JSON=

# --- AI interviewer voice (Google Cloud Text-to-Speech) ---
# Enables the 3D interviewer with lip-sync. Without it the interview uses the
# browser's voice and the 2D avatar. Google Cloud console -> enable
# "Cloud Text-to-Speech API" -> Credentials -> API key restricted to that API.
GOOGLE_TTS_API_KEY=
# Allowed voices, first = default. Must support SSML marks (Standard/WaveNet/Neural2).
INTERVIEW_TTS_VOICES=en-IN-Neural2-A,en-IN-Neural2-D

# --- Web search for market data (optional) ---
SERPER_API_KEY=
TAVILY_API_KEY=

# --- Cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# --- Running more than one API replica (OPERATIONS.md section 8) ---
# Shared rate-limit counters. Empty = this process's memory (one replica).
RATE_LIMIT_STORAGE_URI=

# --- Background jobs (planning weeks off the request) ---
JOB_WORKERS=2
JOB_POLL_SECONDS=1
JOB_STALE_MINUTES=10
JOB_KEEP_DAYS=7

# --- Email ---
# NOTE: plain SMTP does NOT work on Railway — outbound ports 25/465/587 are
# blocked, so smtplib just hangs (see commit dd8faff). Both transports below
# send over HTTPS/443 instead.

# Gmail API (preferred — our own mailbox, no third-party provider).
# Google Cloud Console -> APIs & Services:
#   1. Enable the Gmail API
#   2. OAuth consent screen -> External -> add yourself as a Test user
#   3. Credentials -> OAuth client ID -> Desktop app -> copy ID + secret
#   4. Generate a refresh token with scope https://www.googleapis.com/auth/gmail.send
#      (OAuth Playground: gear icon -> "Use your own OAuth credentials")
# Free @gmail.com sending cap is ~500 recipients/day.
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_FROM_EMAIL=your_sender@example.com
GMAIL_FROM_NAME=Delta by Alpha.Kore

# Brevo (fallback — used only when GMAIL_REFRESH_TOKEN is empty).
# Sender must be verified: Senders, Domains & Dedicated IPs -> Senders.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_sender@example.com
BREVO_FROM_NAME=Delta by Alpha.Kore

# --- Study reminders (opt-in) ---
# Only learners who switch reminders on get them (a recorded consent), at most
# one a day, at the study time they chose, and only if they haven't studied yet.
# Checked every REMINDER_CHECK_INTERVAL_SECONDS and on user traffic (for hosts
# that sleep when idle). One nudge per learner per day is enforced in the DB.
REMINDERS_ENABLED=true
REMINDER_TIMEZONE=Asia/Kolkata   # default timezone for new learners
REMINDER_HOUR_LOCAL=19           # send hour for learners who haven't picked a study time
REMINDER_CHECK_INTERVAL_SECONDS=900
# Shared secret for the manual test trigger: POST /api/reminders/daily
REMINDER_SECRET=generate_a_long_random_string
# Signs one-click unsubscribe links in reminder emails (falls back to REMINDER_SECRET).
EMAIL_LINK_SECRET=generate_another_long_random_string
# Browser push reminders (Web Push / VAPID). Generate a key pair once with:
#   python -m app.services.push_service
# Empty = push off; email reminders still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Coding Sandbox code execution ---
# JDoodle Compiler API (free tier: 200 runs/day). Sign up at jdoodle.com/compiler-api
# -> Compiler API -> copy Client ID + Secret. Without these, the sandbox's
# run/submit endpoints return a clear "not configured" message.
JDOODLE_CLIENT_ID=your_jdoodle_client_id
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret

# --- Frontend (used for links inside emails) ---
FRONTEND_URL=http://localhost:3000

# --- Privacy / recruiter portal ---
# Emails allowed to approve/reject recruiter accounts at /recruiter/admin (comma-separated).
ADMIN_EMAILS=
# Teachers / reviewers allowed to edit and approve Delta for School lessons (comma-separated). Admins can too.
CONTENT_REVIEWER_EMAILS=

# --- Monitoring ---
# Sentry project DSN for error alerts. Empty = disabled. No personal data is sent.
SENTRY_DSN=
LOG_LEVEL=INFO
