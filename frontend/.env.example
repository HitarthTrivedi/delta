# Copy to frontend/.env.development.local (for npm start) and fill in.
# Never commit real keys.

# Bypass CRA preflight eslint version check (project uses eslint 9, CRA ships eslint 7)
SKIP_PREFLIGHT_CHECK=true

# --- API ---
REACT_APP_API_URL=http://localhost:8000/api

# --- Auth (Supabase) ---
# Supabase dashboard -> Project Settings -> API (the public anon key, not the service role key).
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key

# --- Local dev login (development only) ---
# true = sign in with any email, no password, no Supabase. Only works when the
# app is served from localhost, and needs ALLOW_HEADER_AUTH=true in backend/.env.
# Leave empty for anything that is not your own machine.
REACT_APP_DEV_AUTH=
